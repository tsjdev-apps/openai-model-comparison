@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">Skip to content</a>

<header class="app-header">
    <a href="/" class="brand" aria-label="OpenAI Model Comparison home">
        <span class="brand-symbol" aria-hidden="true">
            <svg viewBox="0 0 32 32" focusable="false">
                <path d="m16 2 14 14-14 14L2 16Zm0 4L6 16l10 10 10-10Z" fill="currentColor" fill-rule="evenodd" />
                <path d="m16 11 5 5-5 5-5-5Z" fill="currentColor" />
            </svg>
        </span>
        <span>openai model<span class="brand-light"> / comparison</span></span>
    </a>
    <span class="header-caption">One prompt. Multiple perspectives.</span>
    <nav class="header-actions" aria-label="Application links">
        <button type="button" class="header-link info-button" @onclick="ShowInfoDialog" aria-label="About this app">
            <span aria-hidden="true">ⓘ</span> Info
        </button>
        <a class="header-link" href="https://github.com/tsjdev-apps/openai-model-comparison" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </nav>
</header>

<main id="main-content" class="app-main">
    @Body
</main>

<footer class="app-footer">
    <span>© @DateTime.Now.Year <a href="https://www.tsjdev-apps.de" target="_blank" rel="noopener noreferrer">Thomas Sebastian Jensen</a></span>
    <div class="footer-links">
        <span>Made with Blazor <span class="footer-dot">•</span> One idea, different answers.</span>
        <button type="button" class="text-button imprint-button" @onclick="ShowImprintDialog">Imprint</button>
    </div>
</footer>

<RadzenComponents />
