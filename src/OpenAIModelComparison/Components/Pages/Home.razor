@page "/"

<PageTitle>OpenAI Model Comparison</PageTitle>

<RadzenStack Gap="2rem" Class="rz-p-4">
    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2">
        Welcome to OpenAI Model Comparison
    </RadzenText>
    
    <RadzenText TextStyle="TextStyle.Body1">
        Configure your settings and compare different OpenAI models side by side.
    </RadzenText>

    <RadzenCard>
        <RadzenStack Gap="1.5rem">
            <!-- OpenAI API Key Input -->
            <RadzenFormField Text="OpenAI API Key" Variant="Variant.Outlined">
                <RadzenPassword @bind-Value="@apiKey" 
                                Placeholder="Enter your OpenAI API key..." 
                                Style="width: 100%;"
                                Disabled="@(isProcessing || isLoadingModels)" />
            </RadzenFormField>

            <!-- Model Selection -->
            <RadzenFormField Text="Select Models" Variant="Variant.Outlined">
                @if (isLoadingModels)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Class="rz-p-2">
                        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                        <RadzenText TextStyle="TextStyle.Body2">Loading models...</RadzenText>
                    </RadzenStack>
                }
                else if (!availableModels.Any())
                {
                    <RadzenText TextStyle="TextStyle.Body2" Class="rz-p-2">
                        No models available. Please check your configuration.
                    </RadzenText>
                }
                else
                {
                    <div class="model-selection-grid">
                        @foreach (var model in availableModels)
                        {
                            <div class="model-checkbox-item" @onclick="() => ToggleModel(model)" style="@(isProcessing ? "cursor: not-allowed;" : "cursor: pointer;")">
                                <RadzenCheckBox @bind-Value="@model.IsSelected" 
                                                Name="@model.Name" 
                                                TValue="bool"
                                                Change="@(() => OnModelSelectionChanged(model))"
                                                Id="@model.Name"
                                                Disabled="@isProcessing"
                                                @onclick:stopPropagation="true" />
                                <span class="model-label" style="@(isProcessing ? "opacity: 0.5;" : "")">@model.DisplayName</span>
                            </div>
                        }
                    </div>
                }
            </RadzenFormField>

            <!-- Advanced Settings Section -->
            <RadzenCard Style="background-color: #f8f9fa; padding: 1rem;">
                <RadzenStack Gap="1rem">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                        <RadzenText TextStyle="TextStyle.Subtitle1">
                            Advanced Settings
                        </RadzenText>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                            @if (showAdvancedSettings)
                            {
                                <RadzenButton Text="Reset" 
                                            Icon="refresh" 
                                            ButtonStyle="ButtonStyle.Light"
                                            Size="ButtonSize.Small"
                                            Click="@ResetAdvancedSettings"
                                            Disabled="@(isProcessing || isLoadingModels)" />
                            }
                            <RadzenButton Text="@(showAdvancedSettings ? "Hide" : "Show")" 
                                        Icon="@(showAdvancedSettings ? "expand_less" : "expand_more")" 
                                        ButtonStyle="ButtonStyle.Light"
                                        Size="ButtonSize.Small"
                                        Click="@ToggleAdvancedSettings"
                                        Disabled="@(isProcessing || isLoadingModels)" />
                        </RadzenStack>
                    </RadzenStack>

                    @if (showAdvancedSettings)
                    {
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Max Tokens" Variant="Variant.Outlined" Style="width: 100%;">
                                    <ChildContent>
                                        <RadzenNumeric @bind-Value="@maxTokens" 
                                                       TValue="int?"
                                                       Placeholder="Default (model specific)"
                                                       Min="1"
                                                       Max="32000"
                                                       ShowUpDown="false"
                                                       Style="width: 100%;"
                                                       Disabled="@(isProcessing || isLoadingModels)" />
                                    </ChildContent>
                                    <Helper>
                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: #666; font-size: 0.75rem;">
                                            Maximum number of tokens to generate (leave empty for model default)
                                        </RadzenText>
                                    </Helper>
                                </RadzenFormField>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Temperature" Variant="Variant.Outlined" Style="width: 100%;">
                                    <ChildContent>
                                        <RadzenNumeric @bind-Value="@temperature" 
                                                       TValue="float?"
                                                       Min="0"
                                                       Max="2"
                                                       Step="0.1"
                                                       ShowUpDown="true"
                                                       Style="width: 100%;"
                                                       Disabled="@(isProcessing || isLoadingModels)" />
                                    </ChildContent>
                                    <Helper>
                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: #666; font-size: 0.75rem;">
                                            Sampling temperature (0-2). Higher = more random. Default: 1.0
                                        </RadzenText>
                                    </Helper>
                                </RadzenFormField>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Top P" Variant="Variant.Outlined" Style="width: 100%;">
                                    <ChildContent>
                                        <RadzenNumeric @bind-Value="@topP" 
                                                       TValue="float?"
                                                       Placeholder="Default"
                                                       Min="0"
                                                       Max="1"
                                                       Step="0.1"
                                                       ShowUpDown="true"
                                                       Style="width: 100%;"
                                                       Disabled="@(isProcessing || isLoadingModels)" />
                                    </ChildContent>
                                    <Helper>
                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: #666; font-size: 0.75rem;">
                                            Nucleus sampling (0-1). Alternative to temperature
                                        </RadzenText>
                                    </Helper>
                                </RadzenFormField>
                            </RadzenColumn>

                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Frequency Penalty" Variant="Variant.Outlined" Style="width: 100%;">
                                    <ChildContent>
                                        <RadzenNumeric @bind-Value="@frequencyPenalty" 
                                                       TValue="float?"
                                                       Placeholder="Default (0)"
                                                       Min="-2"
                                                       Max="2"
                                                       Step="0.1"
                                                       ShowUpDown="true"
                                                       Style="width: 100%;"
                                                       Disabled="@(isProcessing || isLoadingModels)" />
                                    </ChildContent>
                                    <Helper>
                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: #666; font-size: 0.75rem;">
                                            Penalty for token frequency (-2.0 to 2.0). Positive = less repetition
                                        </RadzenText>
                                    </Helper>
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                    }
                </RadzenStack>
            </RadzenCard>

            <!-- Message Input -->
            <RadzenFormField Text="Your Message" Variant="Variant.Outlined">
                <RadzenTextArea @bind-Value="@userMessage" 
                                Placeholder="Enter your message to send to the selected models..." 
                                Rows="5" 
                                Style="width: 100%;"
                                Disabled="@(isProcessing || isLoadingModels)" />
            </RadzenFormField>

            <!-- Send Button -->
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Text="Send to Models" 
                              Icon="send" 
                              ButtonStyle="ButtonStyle.Primary"
                              Click="@SendMessage"
                              Disabled="@(!CanSendMessage())" />
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>

    <!-- Processing Indicator -->
    @if (isProcessing)
    {
        <RadzenCard>
            <RadzenStack Gap="1rem" AlignItems="AlignItems.Center">
                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                <RadzenText TextStyle="TextStyle.Body1">
                    Processing model @currentModelIndex of @totalModels...
                </RadzenText>
                @if (totalModels > 0)
                {
                    <RadzenProgressBar Value="@((double)currentModelIndex / totalModels * 100)" 
                                       ShowValue="true" 
                                       Style="width: 300px;" />
                }
            </RadzenStack>
        </RadzenCard>
    }

    <!-- Results Section -->
    @if (comparisonResults.Any() && !isProcessing)
    {
        <RadzenCard>
            <RadzenStack Gap="1.5rem">
                <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H3">
                    Comparison Results
                </RadzenText>

                <!-- Results Table -->
                <RadzenDataGrid Data="@comparisonResults" TItem="ModelComparisonResult" 
                                AllowColumnResize="true" AllowSorting="true">
                    <Columns>
                        <RadzenDataGridColumn TItem="ModelComparisonResult" Property="ModelDisplayName" Title="Model" Width="180px" />
                        <RadzenDataGridColumn TItem="ModelComparisonResult" Property="InputTokens" Title="Input Tokens" Width="110px" TextAlign="TextAlign.Right" />
                        <RadzenDataGridColumn TItem="ModelComparisonResult" Property="OutputTokens" Title="Output Tokens" Width="120px" TextAlign="TextAlign.Right" />
                        <RadzenDataGridColumn TItem="ModelComparisonResult" Property="TotalTokens" Title="Total Tokens" Width="110px" TextAlign="TextAlign.Right" />
                        <RadzenDataGridColumn TItem="ModelComparisonResult" Property="EstimatedCost" Title="Est. Cost ($)" Width="110px" TextAlign="TextAlign.Right" FormatString="{0:F6}" />
                        <RadzenDataGridColumn TItem="ModelComparisonResult" Property="DurationInSeconds" Title="Duration (s)" Width="110px" TextAlign="TextAlign.Right" FormatString="{0:F2}" />
                        <RadzenDataGridColumn TItem="ModelComparisonResult" Title="Status" Width="100px">
                            <Template Context="result">
                                @if (result.IsSuccess)
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Success" />
                                }
                                else
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Failed" />
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>

                <!-- Response Cards -->
                <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin-top: 1rem;">
                    Responses
                </RadzenText>

                <div class="response-cards-grid">
                    @foreach (var result in comparisonResults.Where(r => r.IsSuccess))
                    {
                        <RadzenCard class="response-card" @onclick="@(() => ShowResponseDetail(result))">
                            <RadzenStack Gap="0.5rem">
                                <RadzenText TextStyle="TextStyle.Subtitle2">
                                    @result.ModelDisplayName
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.Body2" class="response-preview">
                                    @GetResponsePreview(result.Response)
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.Caption" Style="color: #666;">
                                    Click to view full response
                                </RadzenText>
                            </RadzenStack>
                        </RadzenCard>
                    }
                </div>

                @if (comparisonResults.Any(r => !r.IsSuccess))
                {
                    <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin-top: 1rem; color: #d32f2f;">
                        Errors
                    </RadzenText>

                    @foreach (var result in comparisonResults.Where(r => !r.IsSuccess))
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">
                            <strong>@result.ModelDisplayName:</strong> @result.ErrorMessage
                        </RadzenAlert>
                    }
                }
            </RadzenStack>
        </RadzenCard>
    }
</RadzenStack>
