<section class="advanced-settings">
    <button type="button"
            class="advanced-settings-toggle"
            @onclick="HandleSummaryClick"
            disabled="@IsDisabled"
            aria-expanded="@IsExpanded.ToString().ToLowerInvariant()"
            aria-controls="advanced-settings-body">
        <span>Advanced settings</span>
        <span class="advanced-summary-icon" aria-hidden="true">@(IsExpanded ? "−" : "+")</span>
    </button>
    @if (IsExpanded)
    {
        <div id="advanced-settings-body" class="advanced-settings-body">
            <div class="settings-field">
                <label for="max-output-tokens">Max output tokens</label>
                <RadzenNumeric id="max-output-tokens"
                               @bind-Value="@MaxTokens"
                               TValue="int?"
                               Placeholder="Model default"
                               Min="1"
                               Max="128000"
                               ShowUpDown="false"
                               Disabled="@IsDisabled" />
                <p class="field-note">Includes visible and reasoning tokens. Leave empty to use the model default.</p>
            </div>
            <button type="button" class="text-button" @onclick="HandleResetClick" disabled="@IsDisabled">Reset setting</button>
        </div>
    }
</section>
