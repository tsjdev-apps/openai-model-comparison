@using OpenAIModelComparison.Models

@if (IsLoading)
{
    <div class="model-loading" role="status">
        <span class="loader"></span>
        <span>Loading model catalogue...</span>
    </div>
}
else if (!Models.Any())
{
    <p class="empty-models">No models are available. Please check the application configuration.</p>
}
else
{
    <div class="model-selection-list" aria-label="Available OpenAI models">
        @foreach (OpenAIModel model in Models)
        {
            <label class="model-option @(model.IsSelected ? "selected" : "")">
                <input type="checkbox"
                       checked="@model.IsSelected"
                       disabled="@IsDisabled"
                       @onchange="() => OnModelToggled.InvokeAsync(model)" />
                <span class="model-copy">
                    <strong>@model.DisplayName</strong>
                    <span>@model.Name</span>
                </span>
            </label>
        }
    </div>
    <p class="field-note">Select one or more models. Every selected model receives the same prompt.</p>
}
