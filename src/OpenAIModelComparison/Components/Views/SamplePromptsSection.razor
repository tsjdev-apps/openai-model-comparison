@using OpenAIModelComparison.Models

@if (SamplePrompts.Any())
{
    <div class="sample-prompts" aria-label="Sample prompts">
        @foreach (SamplePrompt sample in SamplePrompts)
        {
            <button type="button"
                    class="sample-button"
                    disabled="@IsDisabled"
                    @onclick="() => OnSampleSelected.InvokeAsync(sample)"
                    title="@sample.Description">
                <span>@sample.Title</span>
                <RadzenIcon Icon="@sample.Icon" />
                <span aria-hidden="true">↗</span>
            </button>
        }
    </div>
}
