@using OpenAIModelComparison.Models

<div class="comparison-results">
    <div class="metrics-strip" aria-label="Comparison summary">
        <div><span>Successful responses</span><strong>@Results.Count(r => r.IsSuccess) / @Results.Count</strong></div>
        <div><span>Total tokens</span><strong>@Results.Sum(r => r.TotalTokens).ToString("N0")</strong></div>
        <div><span>Estimated cost</span><strong>USD @Results.Sum(r => r.EstimatedCost).ToString("F6")</strong></div>
        <div><span>Average duration</span><strong>@(Results.Count > 0 ? Results.Average(r => r.DurationInSeconds).ToString("F2") : "0.00") s</strong></div>
    </div>

    <div class="response-cards-grid">
        @foreach (var result in Results)
        {
            <article class="response-card @(result.IsSuccess ? "" : "failed")">
                <div class="result-heading">
                    <div>
                        <span class="provider-label">OPENAI</span>
                        <h3>@result.ModelDisplayName</h3>
                    </div>
                    <span class="status-badge @(result.IsSuccess ? "success" : "error")">@(result.IsSuccess ? "Ready" : "Error")</span>
                </div>

                @if (result.IsSuccess)
                {
                    <button type="button" class="response-preview-button" @onclick="@(() => OnResultSelected.InvokeAsync(result))">
                        <span class="response-preview">@GetResponsePreview(result.Response, 420)</span>
                        <span class="view-response">Read full response ↗</span>
                    </button>
                }
                else
                {
                    <div class="result-error">
                        <span aria-hidden="true">!</span>
                        <p>@result.ErrorMessage</p>
                    </div>
                }

                <div class="result-meta">
                    <span>@result.InputTokens.ToString("N0") in</span>
                    <span>@result.OutputTokens.ToString("N0") out</span>
                    <span>USD @result.EstimatedCost.ToString("F6")</span>
                    <span>@result.DurationInSeconds.ToString("F2") s</span>
                </div>
            </article>
        }
    </div>
</div>
